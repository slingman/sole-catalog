# Supabase (safe to expose to the client — protect data with RLS policies)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — server-side only. No VITE_ prefix: this must NOT be bundled
# into client code. Used by api/claude.js (Vercel) and the vite.config.js
# dev proxy (npm run dev).
ANTHROPIC_API_KEY=
